ARG PYTHON_VERSION=3.12
# Deliberately a mutable tag, unlike the uv pin below (PIR-816).
#
# This is the OS/security-patch surface, and `build-ci-image.yml` runs a weekly
# cron whose whole purpose is to refresh it. Pinning a digest here would turn
# that refresh into a no-op and hold CI on an ageing base until someone merged a
# bump — trading a real, automatic security benefit for reproducibility we do not
# need at this layer, since what the build actually consumes (uv, hatchling,
# ruff, pyright) is pinned individually.
#
# The tag is also ARG-parameterised across four Python versions, so one digest
# could not express it in any case.
FROM python:${PYTHON_VERSION}-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      gfortran \
      libopenblas-dev \
      liblapack-dev \
      pkg-config \
      gdal-bin \
      libgdal-dev \
      libsndfile1 \
      libbz2-dev \
      liblzma-dev \
      libcurl4-openssl-dev \
      libeccodes-dev \
      ffmpeg \
      curl \
      git \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install uv from the official distroless image — no shell needed.
#
# Pinned by digest (PIR-816). `:latest` here meant the uv that builds every wheel
# in `build-wheelhouse` changed without a commit — the same unpinned-toolchain
# drift that silently broke publishing through hatchling (PIR-806), one level up.
# The digest is the multi-arch index for 0.12.5; keep it in step with the
# `version:` pinned on every astral-sh/setup-uv use, so the uv that builds inside
# this image and the uv that builds in the workflows are the same uv.
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /usr/local/bin/uv

ENV UV_PYTHON_PREFERENCE=only-system

# Per-package dependency pre-bake (independent libraries, no workspace).
#   * PACKAGE="" → plain base image (system libs + python + uv only). Used by the
#     orchestration / cross-package jobs (build-wheelhouse, unified, isolation,
#     import-graph, version-lockstep), which install from the per-run wheelhouse.
#   * PACKAGE=pirn-<x> → bake THIS package + all its extras (minus the heavy ML
#     wheels torch/tensorflow/tflite, which Dockerfile.ci-heavy layers on) into
#     the system environment. The matching lint/test job (pirn-ci-<x>) then
#     re-installs the package editable in milliseconds — every third-party and
#     cross-package dep is already present and compiled.
ARG PACKAGE=""
COPY packages/ /opt/src/packages/
WORKDIR /opt/src
RUN set -eux; \
    if [ -n "${PACKAGE}" ]; then \
      for p in pirn-core pirn-signal pirn-data pirn-ml pirn-agents pirn-health pirn-oilgas; do \
        uv build "packages/$p" -o /tmp/wh; \
      done; \
      extras=$(python3 -c "import tomllib;d=tomllib.load(open('packages/${PACKAGE}/pyproject.toml','rb'));print(','.join(k for k in d.get('project',{}).get('optional-dependencies',{}) if k not in {'pytorch','tensorflow','tflite'}))"); \
      spec="${PACKAGE}"; [ -n "${extras}" ] && spec="${PACKAGE}[${extras}]"; \
      uv pip install --system --find-links /tmp/wh "${spec}"; \
    fi; \
    rm -rf /opt/src /tmp/wh
WORKDIR /
